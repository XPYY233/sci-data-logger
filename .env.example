# Qwen / DashScope OpenAI-compatible API.
DASHSCOPE_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# Real DashScope vision model. Alternatives: qwen-vl-plus (cheaper),
# qwen-vl-max (pinned latest-major), qwen3-vl-plus (Qwen3 family).
QWEN_VLM_MODEL=qwen-vl-max-latest
QWEN_REQUEST_TIMEOUT=120
QWEN_VL_HIGH_RESOLUTION_IMAGES=true

# Local runtime.
SCI_DATA_LOGGER_STORAGE_ROOT=.local_data
SCI_DATA_LOGGER_INSTRUMENT_REGISTRY=configs/instruments.example.json
SCI_DATA_LOGGER_GROUP_TEMPLATE=configs/group_templates.example.json

# Per-request VLM dispatch concurrency inside ExperimentOrchestrator
# (page fan-out). Each request opens up to this many threads.
SCI_DATA_LOGGER_VLM_CONCURRENCY=4

# Process-wide cap on simultaneous VLM HTTP calls. Hard-protects DashScope
# quota and local socket pool when many requests overlap.
SCI_DATA_LOGGER_VLM_GLOBAL_CONCURRENCY=8
# Seconds to wait for a slot before raising VLMGlobalConcurrencyTimeout.
SCI_DATA_LOGGER_VLM_GLOBAL_ACQUIRE_TIMEOUT=120

# When 'true', drops PagePacket.raw_model_output (verbatim VLM response)
# from the DB row before write. Cuts row size 5-10x at the cost of losing
# the raw VLM payload on next round-trip. Catalogs/events are unaffected.
SCI_DATA_LOGGER_DB_STRIP_RAW_MODEL_OUTPUT=false

# Optional: API-key auth. When unset, all endpoints are open (dev default).
# When set, every request EXCEPT /health must carry header
#   X-API-Key: <value>
# Mismatched / missing key → 401. Use any random string ≥ 16 chars.
# Example:  SCI_DATA_LOGGER_API_KEY=$(openssl rand -hex 32)
SCI_DATA_LOGGER_API_KEY=
